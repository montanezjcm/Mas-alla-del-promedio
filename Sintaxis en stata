set more off
graph set window fontface "Times New Roman"

gl Y="Directorio que contiene las bases de Ensanut"
gl X="Directorio donde se guardarán todos los archivos generados en esta sintaxis"

use "$Y/hogar_ensanut2023_w_n.dta", clear
merge 1:1 FOLIO_I using "$Y/ENSANUT2023_ICB.dta" 
sum indice1
gen nse = [(indice1-r(min))/(r(max)-r(min))] * (100-0) + 0
sum nse,d
drop _merge
rename ponde_f ponde_hog

rename sexo sexo_jefe
rename edad edad_jefe
merge 1:m FOLIO_I using "$Y/integrantes_ensanut2023_w_n.dta"
keep if _merge==3
drop _merge

rename ponde_f ponde_int

merge 1:1 FOLIO_I FOLIO_INT  using "$Y/adultos_ensanut2023_w_n.dta"
keep if _merge==3
drop _merge

merge 1:1 FOLIO_I FOLIO_INT  using "$Y/tomas_de_sangre_w8.dta"
*keep if _merge==3
*drop _merge

** DIAGNOSTICO PREVIO DE DIABETES ** 
svyset upm [pweight=ponde_f], strata(est_sel ) vce(linearized) singleunit(certainty)     //  https://doi.org/10.21149/13774
tab a0301, mis
tab a0301, mis nol
	recode a0301 (3=0), gen(diabetes)
	tab a0301 diabetes, mis
	tab a0301 diabetes, mis nol
	tab a0301 diabetes [iw=ponde_f], cell mis
	tab diabetes sexo [iw=ponde_f], col mis
	label define si 0"No" 1"Si", modify
	label value diabetes si
	label var diabetes "¿Algún médico le ha dicho que tiene diabetes (o alta el azúcar en la sangre)"

tab a0401
tab a0401, nol
recode a0401 (1=1)(2=.) (3=0), gen(hta)
	
tab san01, mis			// solo 1551 con medición de muestra de sangre venosa
tab san01 _merge, mis	// 125 sin información en el cuestionario de adultos
tab san04 san01 if _merge==3, mis	// 1+3+1+1+8+31+17=62 con menos de 8 horas de ayuno
di "63 personas que tenían menos de ocho horas de ayuno=   " 1+4+1+1+8+31+17
tab  san01 if _merge==3 & san04>=8, mis
tab  san01 if _merge==3 & san04>=8
tab  san01 a0808 if _merge==3 & san04>=8, mis	// 9 mujeres embarazadas
tab  san01 a0301 if _merge==3 & san04>=8 & a0808!=1, mis	// 4 con DM gestacional

tab  san01 a0301 if _merge==3 & san04>=8 & a0808!=1 & a0301!=2, mis	// 1351 con HB

tab a0301 if 7<san04 & _merge==3 &  a0808!=1 &  a0301!=2, sum(GLU_SUERO) mis // 1359 con GLU_SUERO
tab a0301  if 7<san04 & _merge==3 &  a0808!=1 &  a0301!=2  & GLU_SUERO!=.   // 1359 con GLU_SUERO
tab a0301 [iw=ponde_st_2] if 7<san04 & _merge==3 &  a0808!=1 &  a0301!=2  & GLU_SUERO!=. 
tab a0301 [iw=ponde_suero_2] if 7<san04 & _merge==3 &  a0808!=1 &  a0301!=2  & GLU_SUERO!=. 

***************************************************************************************************
*** Filtro: Nos quedamos solo con la muestra analitica: 1359 individuos con medición de glucosa ***
***************************************************************************************************
keep if 7<san04 & _merge==3 &  a0808!=1 &  a0301!=2  & GLU_SUERO!=.
save "$X/GLU_SUERO.dta", clear
