program define quantilmeasures
	version 13
	syntax varlist [if][in]
	qui centile `varlist', centile(20)
	local p20= (r(c_1))
	qui centile `varlist', centile(80)
	local p80= (r(c_1))
	* Quantile-Based Scale
	local QSC20=(`p80'-`p20')		// for p<0.5
	* Quantile-Based Skewness
	qui sum `varlist',d
	* Quantile-Based Scale
	local QSC25=r(p75)-r(p25)		// for p<0.5
	local QSC10=r(p90)-r(p10)		// for p<0.5
	* Quantile-Based Skewness
	local QSK25= (r(p75)-r(p50))/(r(p50)-r(p25)) - 1	// for p<0.5
	local QSK20= (`p80'-r(p50))/(r(p50)-`p20') - 1	// for p<0.5
	local QSK10= (r(p90)-r(p50))/(r(p50)-r(p10)) - 1	// for p<0.5
	capture drop e2					// Drop e2 if it already exists
	matrix QSK=(`QSC25', `QSC20', `QSC10',`QSK25',`QSK20',`QSK10')'
	matrix rownames QSK = QSC25 QSC05 QSC10 QSK25 QSK20 QSK10
	matrix colnames QSK = `varlist'
	matrix list QSK
end
